{
	"$schema": "http://json-schema.org/draft-07/schema",
	"title": "JSON Schema for creating a topic route",
	"type": "object",
	"properties": {
		"env": { "type": "string", "minLength": 1 },
		"source": { "type": "string", "minLength": 1 },
		"topic": { "type": "string", "minLength": 1 }
	},
	"required": [ "env", "source", "topic" ]
}
