# Base URL of the webhook-middleware backend (Go/Echo service).
# Can also be changed at runtime from the dashboard's Settings page
# (stored in the browser's localStorage) without rebuilding.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8090

# Optional: sent as the X-API-Key header on every /dashboard/* request,
# matching DASHBOARD_API_KEY on the backend. Leave blank if the backend
# doesn't set DASHBOARD_API_KEY. Can also be set/overridden per-browser
# from the Settings page.
NEXT_PUBLIC_API_KEY=
