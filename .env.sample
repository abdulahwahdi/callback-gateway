# Copy this file to .env and adjust for your environment.

# --- candi base configuration ---
ENVIRONMENT=development #development,staging,production
DEBUG_MODE=true
LOAD_CONFIG_TIMEOUT=20s
# Handlers: REST API + cron scheduler (runs the retry-failed and topic-route-refresh jobs)
USE_REST=true
USE_CRON_SCHEDULER=true
HTTP_PORT=8090
MAX_GOROUTINES=10
# Jaeger OTLP gRPC endpoint. Local: 127.0.0.1:4317; in docker (stack_stack network): jaeger:4317
OTEL_TRACING_HOST=127.0.0.1:4317

# --- Database (PostgreSQL) ---
SQL_DB_READ_DSN=postgres://postgres:postgres@localhost:5432/webhook_middleware?sslmode=disable&TimeZone=Asia/Jakarta
SQL_DB_WRITE_DSN=postgres://postgres:postgres@localhost:5432/webhook_middleware?sslmode=disable&TimeZone=Asia/Jakarta

# --- Environment ---
# Deployment environment name, e.g. development/staging/production.
# Substituted for ":env" in the Kafka topic templates below, and matched
# against kafka_topic_routes DB overrides (see below).
APP_ENV=development

# --- Kafka ---
# Comma-separated list of broker addresses (no spaces).
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_VERSION=2.0.0
KAFKA_CLIENT_ID=webhook-middleware
# Every event, from every source, is published here (key = source) so any
# service can subscribe once and get everything. May reference ":env",
# e.g. webhook_gateway_events_:env -> webhook_gateway_events_production.
KAFKA_COMMON_TOPIC=webhook_gateway_events
# Used to build the default per-source topic template below (kept separate
# so existing "<prefix>.<source>" topics don't move if you only set APP_ENV).
KAFKA_TOPIC_PREFIX=webhook_gateway
# Per-source topic template. May reference ":env" and ":source". Defaults to
# "<KAFKA_TOPIC_PREFIX>.:source" (env-agnostic, e.g. webhook_gateway.midtrans).
# Set this to get one topic per environment per source, e.g.:
#   KAFKA_SOURCE_TOPIC_TEMPLATE=webhook_gateway.:env.:source
# -> webhook_gateway.production.midtrans, webhook_gateway.staging.xendit, etc.
# KAFKA_SOURCE_TOPIC_TEMPLATE=webhook_gateway.:env.:source
# Max retry attempts for a failed publish before the retry worker gives up on it
# (still visible/re-triggerable manually from the dashboard).
MAX_PUBLISH_RETRIES=5
# How often the in-memory cache of DB topic-route overrides
# (kafka_topic_routes table, managed via /dashboard/topic-routes) is
# refreshed in the background. Changes made through the API also take
# effect immediately, without waiting for this interval.
KAFKA_TOPIC_ROUTE_REFRESH_INTERVAL=30s

# --- Retry cron job ---
# How often to sweep for failed publishes and retry them.
RETRY_WORKER_INTERVAL=1m
RETRY_WORKER_BATCH=50

# --- Dashboard auth ---
# If set, every /dashboard/* endpoint requires header: X-API-Key: <value>.
# Leave empty for local development.
DASHBOARD_API_KEY=

# Dashboard login page. When BOTH are set, the frontend shows a login form and
# /dashboard/* requires the session token issued by POST /auth/login.
# Leave empty to disable login (open dashboard, or API-key only).
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
# Signs session tokens. If empty, a random one is generated at startup
# (everyone is logged out on restart). Set a long random string in production.
DASHBOARD_AUTH_SECRET=
# How long a login session lasts.
DASHBOARD_SESSION_TTL=24h

# --- Optional per-source signature/token verification ---
# Uncomment and fill in per payment gateway you want verified.
# Mode is either "token" (static header must equal secret) or
# "hmac" (header must equal hex(HMAC-SHA256(raw body, secret))).
#
# Example: Xendit callback token
# WEBHOOK_VERIFY_XENDIT_MODE=token
# WEBHOOK_VERIFY_XENDIT_HEADER=x-callback-token
# WEBHOOK_VERIFY_XENDIT_SECRET=your-xendit-callback-token
#
# Example: a gateway using an HMAC-SHA256 signature header
# WEBHOOK_VERIFY_STRIPE_MODE=hmac
# WEBHOOK_VERIFY_STRIPE_HEADER=X-Signature
# WEBHOOK_VERIFY_STRIPE_SECRET=your-shared-secret

